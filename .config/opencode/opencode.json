{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "default_agent": "plan",
  "mcp": {
    "servers": {
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp/authv2",
        "disabled": true
      },
      "builder-cms": {
        "type": "remote",
        "url": "https://mcp.builder.io/mcp/publish",
        "disabled": true
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "disabled": true,
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      },
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp",
        "disabled": true
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--executablePath=/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"
        ],
        "disabled": true
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"],
        "disabled": true
      },
      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com/",
        "disabled": true
      },
      "newrelic": {
        "type": "remote",
        "url": "https://mcp.newrelic.com/mcp/",
        "disabled": true
      }
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/dev/**",
      "effect": "allow"
    },
    { "action": "skill", "resource": "daily-health-check", "effect": "allow" },
    { "action": "skill", "resource": "scaffold-app", "effect": "allow" }
  ],
  "plugins": ["@slkiser/opencode-quota@next"]
}
