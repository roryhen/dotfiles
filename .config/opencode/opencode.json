{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "mcp": {
    "servers": {
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp/authv2"
      },
      "builder-cms": {
        "type": "remote",
        "url": "https://mcp.builder.io/mcp/publish"
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      },
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp",
        "disabled": true
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--executablePath=/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"
        ]
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"]
      },
      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com/"
      },
      "newrelic": {
        "type": "remote",
        "url": "https://ai-gateway.engforbestech.com/newrelic/mcp",
        "oauth": false,
        "headers": {
          "x-litellm-api-key": "Bearer {env:AI_GATEWAY_TOKEN}"
        }
      }
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/dev/**",
      "effect": "allow"
    }
  ],
  "plugins": ["@slkiser/opencode-quota"],
  "provider": {
    "github-copilot": {},
    "vercel": {}
  }
}
