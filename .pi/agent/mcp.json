{
  "mcpServers": {
    "atlassian": {
      "url": "https://mcp.atlassian.com/v2/mcp"
    },
    "builder-cms-forbes": {
      "url": "https://mcp.builder.io/mcp/publish"
    },
    "builder-cms-microsites": {
      "url": "https://mcp.builder.io/mcp/publish"
    },
    "builder-cms-mnet": {
      "url": "https://mcp.builder.io/mcp/publish"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "!echo Bearer $(gh auth token)"
      }
    },
    "figma": {
      "url": "https://mcp.figma.com/mcp",
      "oauth": {
        "clientName": "Claude Code"
      }
    },
    "miro-mcp": {
      "url": "https://mcp.miro.com/"
    },
    "newrelic": {
      "url": "https://ai-gateway.engforbestech.com/newrelic/mcp",
      "headers": {
        "x-litellm-api-key": "Bearer ${AI_GATEWAY_TOKEN}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "slack": {
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "callbackUrl": "http://localhost:3118/callback"
      }
    },
    "vercel": {
      "url": "https://mcp.vercel.com/",
      "oauth": {
        "scope": "openid offline_access"
      }
    }
  }
}
