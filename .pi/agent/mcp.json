{
  "mcpServers": {
    "atlassian": {
      "url": "https://mcp.atlassian.com/v2/mcp"
    },
    "builder-cms": {
      "url": "https://mcp.builder.io/mcp/publish"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "!echo Bearer $(gh auth token)"
      }
    },
    "figma": {
      "url": "https://mcp.figma.com/mcp",
      "oauth": {
        "clientName": "Claude Code"
      }
    },
    "miro-mcp": {
      "url": "https://mcp.miro.com/"
    },
    "newrelic": {
      "url": "https://ai-gateway.engforbestech.com/newrelic/mcp",
      "headers": {
        "x-litellm-api-key": "Bearer ${AI_GATEWAY_TOKEN}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "vercel": {
      "url": "https://mcp.vercel.com/"
    }
  }
}
