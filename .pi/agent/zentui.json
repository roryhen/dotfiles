{
  "components": {
    "editor": {
      "enabled": true,
      "style": "opencode-copy-friendly"
    },
    "footer": {
      "style": "starship",
      "codexQuota": false,
      "colorSource": "terminal",
      "modelLabel": "id",
      "styles": {
        "starship": {
          "format": "",
          "responsive": true,
          "compactFormat": "$cwd$wrap(in $session_name)$wrap(on $git_branch) $git_status$wrap$context$wrap_sep$tokens$wrap_sep($codex_quota)",
          "compactMaxLines": 2,
          "separator": "pipe",
          "contextStyle": "text",
          "contextThresholds": {
            "warning": 70,
            "error": 90
          },
          "pathDisplay": {
            "mode": "basename",
            "depth": 0
          },
          "segments": {
            "cwd": true,
            "sessionName": true,
            "gitBranch": true,
            "gitStatus": true,
            "gitCounts": false,
            "gitCommit": false,
            "gitMetrics": false,
            "runtime": true,
            "modelInfo": false,
            "context": true,
            "tokens": true,
            "cost": true,
            "sessionDuration": false,
            "username": false,
            "time": false,
            "os": false,
            "packageVersion": false
          },
          "gitBranch": {
            "maxLength": "full"
          },
          "gitCommit": {
            "hashLength": 7,
            "onlyDetached": true,
            "showTag": true
          },
          "gitMetrics": {
            "onlyNonzero": true,
            "ignoreSubmodules": false
          },
          "extensionStatuses": {
            "defaultPlacement": "left",
            "placements": {},
            "colorModes": {}
          }
        }
      }
    },
    "userMessages": {
      "enabled": true,
      "style": "framed-copy-friendly",
      "colorSource": "terminal",
      "styles": {
        "framed": {},
        "framed-copy-friendly": {},
        "compact": {},
        "labeled": {}
      },
      "rail": "│",
      "asciiRail": "│"
    },
    "thinkingSteps": {
      "enabled": true,
      "mode": "streaming"
    },
    "workingLine": {
      "enabled": true,
      "turnSummary": true,
      "turnSummaryFormat": "Turn took $turn_duration$join_sep(thought for $thought_duration)$join_sep(↑$input_tokens ↓$output_tokens)$join_sep$token_rate",
      "spinner": "pinwheel",
      "spinnerIntervalMs": 100,
      "animateSpinnerColor": false,
      "textIntervalMs": 60,
      "textAnimation": "classic",
      "placement": "border",
      "colorSource": "terminal",
      "messages": {
        "custom": true,
        "values": [
          "Sautéing…",
          "Cooking…",
          "Ionizing…",
          "Zigzagging…",
          "Razzle-dazzling…",
          "Photosynthesizing…",
          "Nucleating…",
          "Brewing…",
          "Combobulating…",
          "Boogieing…",
          "Befuddling…",
          "Alchemizing…",
          "Conjuring…",
          "Baking…",
          "Simmering…",
          "Blanching…"
        ]
      },
      "segments": {
        "tokenRate": false,
        "tool": true,
        "elapsed": true,
        "thought": true,
        "tokens": false
      }
    },
    "toolDisplay": {
      "enabled": true,
      "style": "balanced",
      "registerToolOverrides": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true,
        "grep": true,
        "find": true,
        "ls": true
      },
      "builtinRendererOverrides": {},
      "customToolOverrides": {},
      "readOutputMode": "summary",
      "searchOutputMode": "count",
      "mcpOutputMode": "summary",
      "bashOutputMode": "summary",
      "bashSyntax": "semantic",
      "previewLines": 8,
      "expandedPreviewMaxLines": 4000,
      "bashCollapsedLines": 10,
      "diffViewMode": "auto",
      "diffIndicatorMode": "bars",
      "diffSplitMinWidth": 120,
      "diffCollapsedLines": 24,
      "diffWordWrap": true,
      "showTruncationHints": false
    },
    "extensionStatuses": {
      "defaultVisibility": "show"
    }
  }
}
