{
  "lastChangelogVersion": "1.1.0",
  "theme": "carbonfox",
  "tuiMode": "fullscreen",
  "shellCommandPrefix": "shopt -s expand_aliases\neval \"$(grep '^alias ' ~/.zshrc)\"",
  "defaultProvider": "github-copilot",
  "defaultModel": "gpt-6-luna",
  "defaultTools": [
    "+grep",
    "+find",
    "+ls",
    "+codemode",
    "+tool_search"
  ],
  "packages": [
    "npm:pi-subagents",
    "npm:pi-lens",
    "npm:jev-use"
  ],
  "editorPaddingX": 1,
  "outputPad": 1
}