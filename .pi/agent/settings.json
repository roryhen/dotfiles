{
  "lastChangelogVersion": "0.99.2",
  "theme": "carbonfox",
  "tuiMode": "fullscreen",
  "shellCommandPrefix": "shopt -s expand_aliases\neval \"$(grep '^alias ' ~/.zshrc)\"",
  "defaultProvider": "github-copilot",
  "defaultModel": "gpt-6-luna",
  "defaultTools": ["+grep", "+find", "+ls", "+codemode", "+tool_search"],
  "packages": [
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:pi-lens",
    "npm:context-mode",
    "npm:@janvitos/pi-plan-build",
    "npm:@each1024/pi-mini-mode",
    "npm:@eiei114/pi-sub-bar"
  ],
  "editorPaddingX": 1,
  "outputPad": 1
}
