{
  "lastChangelogVersion": "1.5.0",
  "theme": "carbonfox",
  "tuiMode": "fullscreen",
  "shellCommandPrefix": "shopt -s expand_aliases\neval \"$(grep '^alias ' ~/.zshrc)\"",
  "defaultTools": [
    "+grep",
    "+find",
    "+ls",
    "+codemode",
    "+tool_search"
  ],
  "packages": [
    "npm:pi-lens",
    "npm:jev-use",
    "npm:pi-claude-bridge",
    "npm:pi-zentui"
  ],
  "editorPaddingX": 1,
  "outputPad": 1,
  "showHardwareCursor": true,
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-lens\",\"scope\":\"user\"}": "4.4.11"
  }
}