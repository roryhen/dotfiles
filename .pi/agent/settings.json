{
  "lastChangelogVersion": "1.4.0",
  "theme": "carbonfox",
  "tuiMode": "fullscreen",
  "shellCommandPrefix": "shopt -s expand_aliases\neval \"$(grep '^alias ' ~/.zshrc)\"",
  "defaultTools": [
    "+grep",
    "+find",
    "+ls",
    "+codemode",
    "+tool_search"
  ],
  "packages": [
    "npm:pi-subagents",
    "npm:pi-lens",
    "npm:jev-use",
    "npm:pi-claude-bridge",
    "npm:pi-tool-display"
  ],
  "editorPaddingX": 1,
  "outputPad": 1
}