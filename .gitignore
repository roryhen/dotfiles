# Ignore everything by default; allowlist below. Credentials block at the end must stay last.
*

# Shell and home files
!Brewfile
!.bashrc
!.gitconfig
!.gitignore
!.inputrc
!install.sh
!.p10k.zsh
!.zshenv
!.zshrc

# Coding agents
!.agents/
!.agents/skills/
!.agents/skills/**
!.claude/
!.claude/skills/
# symlinks to skills in .agents/skills/
!.claude/skills/*
!.config/opencode/
!.config/opencode/AGENTS.md
!.config/opencode/cli.json
!.config/opencode/opencode.json
!.config/opencode/plugins/
!.pi/
!.pi/agent/
!.pi/agent/extensions/
!.pi/agent/extensions/claude-usage.ts
!.pi/agent/extensions/pi-tool-display/
!.pi/agent/extensions/pi-tool-display/config.json
!.pi/agent/keybindings.json
!.pi/agent/mcp.json
!.pi/agent/settings.json
!.pi/agent/themes/
!.pi/agent/themes/*

# ~/.config
!.config/
!.config/container/
!.config/container/config.toml
!.config/ghostty/
!.config/ghostty/*
!.config/git/
!.config/git/ignore
!.config/mise/
!.config/mise/config.toml
!.config/{vim,nvim}/
!.config/{vim,nvim}/*
!.config/{vim,nvim}/lsp/*
!.config/{vim,nvim}/lua/*
!.config/{vim,nvim}/lua/config/*
!.config/{vim,nvim}/lua/plugins/*
!.config/tmux/
!.config/tmux/segments.sh
!.config/tmux/tmux.conf
!.config/tuios/
!.config/tuios/config.toml
!.config/wezterm/
!.config/wezterm/wezterm.lua
!.config/workmux/
!.config/workmux/config.yaml
!.config/zed/
!.config/zed/keymap.json
!.config/zed/settings.json

# Never commit credentials. Keep this block last: later patterns win over the allowlist above.
.claude.json
.config/opencode/service.json
**/*auth*.json
**/*.pem
**/*.key
**/*secret*
**/*token*
**/.credentials.json
**/.env
**/.env.*
**/.npmrc
**/credentials*.json
**/hosts.yml
**/id_ed25519*
**/id_rsa*
